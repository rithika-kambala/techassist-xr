# Supply real values privately. Never commit .env.
PORT=8080
HOST=127.0.0.1
AI_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
# Optional paid provider: AI_MODE=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
TECHNICIAN_TOKEN=
DB_PATH=./storage/techassist.sqlite
DAILY_LIMIT=20
GLOBAL_DAILY_LIMIT=100
# Optional multi-user map replaces TECHNICIAN_TOKEN:
# API_TOKENS_JSON={"alice":{"token":"...32+ chars...","role":"technician"},"mentor":{"token":"...different...","role":"expert"}}

# Free Groq alternative: set AI_MODE=groq once your key is configured
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
